# Copy to .env.local. Never commit real keys.

# Supabase (local values come from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by tests and (later) the Moyasar webhook. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Run with local fixtures instead of Supabase (no keys needed). See docs/decisions.md "Demo mode".
DEMO_MODE=false

# Maps: a Mapbox public token, or any MapLibre style URL (takes precedence).
# With neither, the map home falls back to a static map.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAP_STYLE_URL=

# Show the demo phone numbers hint on the login screen (dev/demo only).
NEXT_PUBLIC_SHOW_DEMO_HINT=true

# Moyasar (step 6, sandbox only until live keys are provided)
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
